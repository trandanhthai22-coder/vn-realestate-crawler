# Sao chép thành .env (hoặc đặt biến môi trường trong shell). Mọi biến đều tuỳ chọn.

# Đường dẫn trình duyệt Chromium dùng để giải Cloudflare challenge
# (mặc định tự dò Chrome -> Edge -> Brave -> Chromium)
# BDS_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Thư mục cache cookie cf_clearance (mặc định ~/.cache/bdscrawler)
# BDS_CACHE_DIR=

# Profile giả lập TLS của curl_cffi (mặc định "chrome" = bản Chrome mới nhất có sẵn)
# BDS_IMPERSONATE=chrome

# Chỉ cần khi dùng --backend firecrawl
# FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx
